<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">

  <!-- Step 4: Server credentials -->
  <servers>
    <server>
      <id>vprofileci-aws-vprofile-maven-repo</id>
      <username>aws</username>
      <password>${env.CODEARTIFACT_AUTH_TOKEN}</password>
    </server>
  </servers>

  <!-- Step 5: Profile with repository config -->
  <profiles>
    <profile>
      <id>vprofileci-aws-vprofile-maven-repo</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <repositories>
        <repository>
          <id>vprofileci-aws-vprofile-maven-repo</id>
          <url>https://vprofileci-aws-936222783168.d.codeartifact.us-east-1.amazonaws.com/maven/vprofile-maven-repo/</url>
        </repository>
      </repositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>vprofileci-aws-vprofile-maven-repo</activeProfile>
  </activeProfiles>

  <!-- Step 6: Optional mirror setup -->
  <mirrors>
    <mirror>
      <id>vprofileci-aws-vprofile-maven-repo</id>
      <name>vprofileci-aws-vprofile-maven-repo</name>
      <url>https://vprofileci-aws-936222783168.d.codeartifact.us-east-1.amazonaws.com/maven/vprofile-maven-repo/</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>

</settings>
